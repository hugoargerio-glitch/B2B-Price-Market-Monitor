# ==============================================================================
# DE Agentic Boilerplate (OLAP) — Environment Configuration Template
# Copy to .env and populate secrets locally. NEVER commit .env to version control.
# ==============================================================================

# Workspace & Runtime Paths
WORKSPACE_ROOT=/home/Hugo/de-agentic-boilerplate-olap

# Bruin & DuckDB Local Lakehouse Configuration
BRUIN_ENVIRONMENT=local_duckdb
DUCKDB_PATH=/home/Hugo/de-agentic-boilerplate-olap/local_lakehouse.duckdb

# dbt Core Configuration
DBT_PROFILES_DIR=./dbt_project
DBT_TARGET=dev_duckdb
DBT_STATE_PATH=./target/prod_manifest

# Cryptographic PII Anonymization Salt (LGPD / GDPR Compliance)
PII_HASH_SALT=replace_with_production_256bit_secret_salt

# Enterprise MCP Server Endpoints (Optional in Local-Only Mode)
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
EDR_ENV=dev
