# ==============================================================================
# B2B Price & Market Monitor — Environment Configuration Template
# Copy to .env and populate secrets locally. NEVER commit .env to version control.
# ==============================================================================

# 1. SQLite WAL Database Storage Path
B2B_DB_PATH=./b2b_monitor.db

# 2. Multi-Channel Webhook Notification Endpoint
# Supported platforms (auto-detected by URL):
#   - Discord: https://discord.com/api/webhooks/<id>/<token>
#   - Slack:   https://hooks.slack.com/services/<T000>/<B000>/<XXXX>
#   - Console: Leave empty to render formatted ASCII boxes in stdout (CI / Local Dev)
B2B_WEBHOOK_URL=
